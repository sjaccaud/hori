[Unit]
Description=HORI Thread Consolidation (workstream "Sleep & Dream")
# Folds new episodes into thread state.md (mechanical fields only),
# flags threads with sessions but no episodes, and writes LLM-assisted
# state/rule proposals into the review queue (always status: pending).
# Traces to: .devin/prd/thread-consolidation.md, docs/roadmap.md Tier 1B.
After=network.target llamacpp.service aios_core.service
Wants=llamacpp.service

[Service]
Type=oneshot
# User and WorkingDirectory are set by the install script.
# Defaults shown here work for a single-user install where HORI runs
# as the current user from ~/Projects/hori.
# The install script (scripts/hardening/install_services.sh) replaces
# these with the actual user and path.
User=%i
WorkingDirectory=%h/Projects/hori
Environment=PYTHONPATH=.
Environment=LLM_API_URL=http://localhost:8080/v1/chat/completions
Environment=LLM_MODEL=qwen-fast
ExecStart=%h/Projects/hori/venv/bin/python3 scripts/thread_consolidation.py
# LLM calls are bounded but can be slow; mechanical stages are instant.
TimeoutStartSec=600
StandardOutput=journal
StandardError=journal
