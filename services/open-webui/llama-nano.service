[Unit]
Description=Llama.cpp nano model (Llama-3.2-3B, instant chat, port 8090)
# User unit — installed to ~/.config/systemd/user/ via `make install-llama-nano`.
# Runs alongside the llamacpp.service router on :8080; small enough (~2.5 GB
# VRAM at 8k ctx) to stay resident next to the 27B presets, so Open-WebUI can
# offer an instant-reply model without evicting the big one.
After=graphical-session.target

[Service]
Environment="LD_LIBRARY_PATH=/opt/rocm/core-7.14/lib:/opt/rocm/core-7.14/lib/rocm_sysdeps/lib:/opt/rocm/core-7.14/lib/llvm/lib:%h/llama-builds/spiritbuun-714/bin"
Environment="LLAMA_ARG_MLOCK=1"
ExecStart=%h/llama-builds/spiritbuun-714/bin/llama-server --host 127.0.0.1 --port 8090 --model /opt/ai-models/Llama-3.2-3B-Instruct-Q4_K_M.gguf --alias nano --ctx-size 8192 --jinja --flash-attn on --cache-type-k q4_0 --cache-type-v q4_0 --parallel 1
Restart=always
RestartSec=5

[Install]
WantedBy=default.target
