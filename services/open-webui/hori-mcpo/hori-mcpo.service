[Unit]
Description=mcpo bridge: hori aios MCP (SSE) -> OpenAPI for Open-WebUI
After=network-online.target

[Service]
# mcpo snapshots the MCP tool list once at startup and never reconnects.
# User services can't After= a system unit, so gate on aios_core readiness
# directly — starting before :5680 leaves a permanently empty tool spec
# (2026-09-22 login race: mcpo 04:04:37 vs aios_core 04:04:43).
ExecStartPre=/bin/sh -c 'for i in $(seq 1 90); do curl -sf -o /dev/null -m 2 http://127.0.0.1:5680/health && exit 0; sleep 2; done; echo "aios_core :5680 not ready after 180s" >&2; exit 1'
# --api-key/--strict-auth (2026-09-23): :8774 exposes ALL hori MCP tools
# including writes; without auth any local process could call them.
# hori-filter.py injects this key upstream; direct hits now 401.
EnvironmentFile=%h/.config/mcpo/mcpo.env
ExecStart=%h/.local/bin/mcpo --host 127.0.0.1 --port 8774 --config %h/.config/mcpo/hori.json --api-key ${MCPO_API_KEY} --strict-auth
Restart=on-failure
RestartSec=5

[Install]
WantedBy=default.target
