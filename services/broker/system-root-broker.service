[Unit]
Description=System Root Broker
After=network.target
StartLimitIntervalSec=0

[Service]
Type=simple
User=root-broker
Group=root-broker
WorkingDirectory=@@REPO_ROOT@@
RuntimeDirectory=system-root-broker
RuntimeDirectoryMode=0755
ExecStart=@@REPO_ROOT@@/venv/bin/python3 -m services.broker.broker
Restart=always
RestartSec=5

# Hardening
ProtectSystem=strict
ProtectHome=read-only
PrivateTmp=true
PrivateDevices=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
RestrictRealtime=true
RestrictNamespaces=true
LockPersonality=true
# The broker's children (systemctl, journalctl) need PROT_EXEC for shared libs.
MemoryDenyWriteExecute=false

Environment=PYTHONPATH=@@REPO_ROOT@@

# The broker must write its audit log and RuntimeDirectory.
# The sandboxed wrappers need to connect to /run/dbus and /run/systemd,
# and journalctl needs to read /var/log/journal.
ReadOnlyPaths=@@REPO_ROOT@@
ReadWritePaths=/var/log/system-root-broker /run/systemd /run/dbus /run/system-root-broker
# Sudo is in /usr/bin, systemctl is in /usr/bin.

# The broker needs to execute systemctl with a very narrow sudoers rule.
# The install script sets up /etc/sudoers.d/system-root-broker.
Environment="BROKER_SECRETS_PATH=/etc/system-root-broker/broker-secrets.env"
Environment="BROKER_ALLOWLIST_PATH=/etc/system-root-broker/broker-allowlist.json"
Environment="BROKER_AUDIT_LOG_PATH=/var/log/system-root-broker/audit.jsonl"
Environment="BROKER_SOCKET_PATH=/run/system-root-broker/broker.sock"

[Install]
WantedBy=multi-user.target
