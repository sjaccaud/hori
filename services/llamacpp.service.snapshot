# Snapshot of working systemd service (Aug 2026)
# Spiritbuun fork + turbo4 + ngram-mod
# To restore: sudo cp this to /etc/systemd/system/llamacpp.service && sudo systemctl daemon-reload && sudo systemctl restart llamacpp

[Unit]
Description=Llama.cpp ROCm Server (Spiritbuun Fork - TurboQuant + VBR + Speculative)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=%i
WorkingDirectory=~/ai-models/llama.cpp
ExecStart=~/ai-models/llama.cpp/build/bin/llama-server \
  --models-dir /opt/ai-models \
  --models-max 1 \
  -c 16384 \
  -fa on \
  --cache-reuse 256 \
  -b 2048 \
  -ub 2048 \
  -ctk turbo4 \
  -ctv turbo4 \
  --spec-type ngram-mod \
  --spec-ngram-mod-n-match 24 \
  --spec-ngram-mod-n-min 48 \
  --spec-ngram-mod-n-max 64 \
  --host 0.0.0.0 \
  --port 8080
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
