{
  "check_interval_seconds": 30,
  "vram_threshold_percent": 90,
  "services": [
    {
      "name": "llamacpp-adaptive",
      "type": "systemd",
      "check_command": "systemctl is-active --quiet llamacpp-adaptive",
      "restart_command": "sudo systemctl restart llamacpp-adaptive"
    },
    {
      "name": "gpu_vram",
      "type": "vram"
    }
  ]
}
